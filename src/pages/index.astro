---
import "@/styles/global.css";
// @ts-ignore: no type declarations for fontsource side-effect import
import "@fontsource-variable/josefin-sans";
import Header from "@/components/Header.astro";
import Pattern from "@/components/Pattern.astro";
import HeroSection from "@/components/HeroSection.astro";
import LinkSection from "@/components/LinkSection.astro";
import Footer from "@/components/Footer.astro";

import GitHubIcon from "@/assets/icons/GitHub.svg";
import MailIcon from "@/assets/icons/MailIcon.svg";
import BlueskyIcon from "@/assets/icons/Bluesky.svg";
import UserCodeIcon from "@/assets/icons/UserCode.svg";
import LinkedInIcon from "@/assets/icons/LinkedIn.svg";



const connect = [
  {
    title: "GitHub",
    icon: GitHubIcon,
    href: "https://github.com/vinaymanala",
    ariaLabel: "View Vinay Manala's projects on GitHub (opens in new tab)",
  },
  {
    title: "Blog",
    icon: UserCodeIcon,
    href: "https://blog.vinyman.fyi",
    ariaLabel:
      "Visit Vinay Manala's blog posts (opens in new tab)",
  },  
  {
    title: "Email",
    icon: MailIcon,
    href: "mailto:vinaymworks@gmail.com",
    ariaLabel: "Send an email to Vinay Manala at vinaymworks@gmail.com",
  },
  {
    title: "LinkedIn",
    icon: LinkedInIcon,
    href: "https://www.linkedin.com/in/vinaymanala/",
    ariaLabel: "Connect with Vinay Manala on LinkedIn (opens in new tab)",
  },
  {
    title: "Bluesky",
    icon: BlueskyIcon,
    href: "https://bsky.app/profile/vinyman.bsky.social",
    ariaLabel: "Follow Vinay Manala on Bluesky (opens in new tab)",
  },
];

const TITLE = "Vinay Manala";
const DESCRIPTION = "All of Vinay Manala's links in one place";
const SITE_URL = "https://vinyman.fyi/";
// const SOCIAL_IMG_URL = image.src;

// Google Analytics Measurement ID
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{TITLE}</title>
    <meta name="title" content={TITLE} />
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <!-- <meta property="og:image" content={SOCIAL_IMG_URL} /> -->

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={SITE_URL} />
    <meta property="twitter:title" content={TITLE} />
    <meta property="twitter:description" content={DESCRIPTION} />
    <!-- <meta property="twitter:image" content={SOCIAL_IMG_URL} /> -->

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Analytics (Partytown) -->
    {
      GA_MEASUREMENT_ID && (
        <>
          <script
            type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script type="text/partytown">
            {`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${GA_MEASUREMENT_ID}');
            `}
          </script>
        </>
      )
    }

    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body
    class:list={["h-dvh w-full", "antialiased bg-background text-foreground"]}
  >
    <div class:list={["max-w-lg mx-auto h-full", "flex flex-col gap-8"]}>
      <Header />

      <HeroSection />      

      <LinkSection title="Connect" links={connect} />      

      <Footer />
    </div>

    <Pattern />
  </body>

  <style>
    body {
      font-family: "Josefin Sans Variable", sans-serif;
    }
  </style>
</html>
