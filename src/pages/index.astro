---
import "@/styles/global.css";
import "@fontsource-variable/josefin-sans";
import Header from "@/components/Header.astro";
import Pattern from "@/components/Pattern.astro";
import HeroSection from "@/components/HeroSection.astro";
import LinkSection from "@/components/LinkSection.astro";

import XIcon from "@/assets/icons/X.svg";
import GitHubIcon from "@/assets/icons/GitHub.svg";
import MailIcon from "@/assets/icons/MailIcon.svg";
import BlueskyIcon from "@/assets/icons/Bluesky.svg";
import TerminalIcon from "@/assets/icons/Terminal.svg";
import UserCodeIcon from "@/assets/icons/UserCode.svg";
import LinkedInIcon from "@/assets/icons/LinkedIn.svg";
import FacebookIcon from "@/assets/icons/Facebook.svg";
import InstagramIcon from "@/assets/icons/Instagram.svg";

const kitchen = [
  {
    title: "GitHub",
    icon: GitHubIcon,
    href: "https://github.com/satnaing",
  },
  {
    title: "Terminal",
    icon: TerminalIcon,
    href: "https://terminal.satnaing.dev",
  },
  {
    title: "Portfolio",
    icon: UserCodeIcon,
    href: "https://satnaing.dev",
  },
];

const connect = [
  {
    title: "Email",
    icon: MailIcon,
    href: "mailto:satnaingdev@gmail.com",
  },
  {
    title: "LinkedIn",
    icon: LinkedInIcon,
    href: "https://www.linkedin.com/in/satnaing/",
  },
];

const socials = [
  {
    title: "Bluesky",
    icon: BlueskyIcon,
    href: "https://bsky.app/profile/satnaing.bsky.social",
  },
  {
    title: "Twitter (X)",
    icon: XIcon,
    href: "https://x.com/SatNaingDev",
  },
  {
    title: "Instagram",
    icon: InstagramIcon,
    href: "https://www.instagram.com/satnaing.dev/",
  },
  {
    title: "Facebook",
    icon: FacebookIcon,
    href: "https://www.facebook.com/satnaing.dev",
  },
];

const TITLE = "Sat Naing";
const DESCRIPTION = "All of Sat Naing's links in one place";
const SITE_URL = "https://satna.ing/";
const SOCIAL_IMG_URL = `${SITE_URL}og.png`;

// Google Analytics Measurement ID
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{TITLE}</title>
    <meta name="title" content={TITLE} />
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={SOCIAL_IMG_URL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={SITE_URL} />
    <meta property="twitter:title" content={TITLE} />
    <meta property="twitter:description" content={DESCRIPTION} />
    <meta property="twitter:image" content={SOCIAL_IMG_URL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Analytics (Partytown) -->
    {
      GA_MEASUREMENT_ID && (
        <>
          <script
            type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script type="text/partytown">
            {`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${GA_MEASUREMENT_ID}');
            `}
          </script>
        </>
      )
    }

    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body
    class:list={["h-dvh w-full", "antialiased bg-background text-foreground"]}
  >
    <div class:list={["max-w-lg mx-auto h-full", "flex flex-col gap-8"]}>
      <Header />

      <HeroSection />

      <LinkSection title="Kitchen" links={kitchen} />

      <LinkSection title="Connect" links={connect} />

      <LinkSection title="Socials" links={socials} />

      <footer class="mt-auto px-4 py-2 flex justify-center items-center gap-2">
        <span class="relative flex size-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"
          ></span>
        </span>
        <span>Bangkok, Thailand</span>
      </footer>
    </div>

    <Pattern />
  </body>

  <style>
    body {
      font-family: "Josefin Sans Variable", sans-serif;
    }
  </style>
</html>
