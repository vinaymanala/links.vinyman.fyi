---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";

import BadgeIcon from "@/assets/icons/badge.svg";
import heroImage from "@/assets/images/vinyman.jpg";
import DownloadIcon from "@/assets/icons/Download.svg";


---

<section
  class="px-4 py-0 sm:py-8 flex flex-col sm:flex-row gap-4 items-center sm:items-start"
>
  <Image
    src={heroImage}
    alt="Vinay Manala"
    priority
    width={200}
    height={200}
    densities={[1.5, 2]}
    quality="max"
    class="rounded-lg shadow-2xl"
  />

  <div
    class="flex-1 sm:self-stretch flex items-center sm:items-start flex-col gap-2"
  >
    <div class="flex gap-2 items-center">
      <h1 class="text-3xl font-bold">Vinay Manala</h1>
      <BadgeIcon class="text-badge" />
    </div>
    <span class="opacity-75 text-lg">Getting work done!</span>
    <span class="opacity-75 text-md">A 27-year-old developer working hard to make a difference.</span>    
    <div class="mt-auto">
      <Button
        isPrimary
        href={import.meta.env.PUBLIC_RESUME_URL}
        aria-label="Download Vinay Manala's resume (opens in new tab)"
      >
        <DownloadIcon width={18} height={18} aria-hidden="true" />
        Resume
      </Button>
    </div>
  </div>
</section>
